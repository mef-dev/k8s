{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claims"
  ],
  "properties": {
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "front",
        "back",
        "api-config"
      ],
      "properties": {
        "front": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "create",
            "storageClass",
            "accessModes",
            "size",
            "retain"
          ],
          "properties": {
            "create": {
              "type": "boolean"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "ReadWriteMany"
                ]
              }
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
            },
            "retain": {
              "type": "boolean"
            }
          }
        },
        "back": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "create",
            "storageClass",
            "accessModes",
            "size",
            "retain"
          ],
          "properties": {
            "create": {
              "type": "boolean"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "ReadWriteMany"
                ]
              }
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
            },
            "retain": {
              "type": "boolean"
            }
          }
        },
        "api-config": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "create",
            "storageClass",
            "accessModes",
            "size",
            "retain"
          ],
          "properties": {
            "create": {
              "type": "boolean"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "ReadWriteMany"
                ]
              }
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
            },
            "retain": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
